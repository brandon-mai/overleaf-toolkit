#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
TOOLKIT_ROOT="$(realpath "$SCRIPT_DIR/..")"

# 1. Dynamically resolve all compose files, overrides, and environment variables
# 2. Enforce 'restart: unless-stopped' strategy for all services
# 3. Prefix container names with 'overleaf-' to avoid naming collisions on ZimaOS
# 4. Remove host_ip: 127.0.0.1 binding so port 8008 is accessible across LAN
COMPOSE_CONFIG="$("${TOOLKIT_ROOT}/bin/docker-compose" config | \
  sed 's/restart: always/restart: unless-stopped/g' | \
  sed 's/container_name: clanker-bot/container_name: overleaf-clanker-bot/g' | \
  sed 's/container_name: mongo/container_name: overleaf-mongo/g' | \
  sed 's/container_name: redis/container_name: overleaf-redis/g' | \
  sed 's/container_name: sharelatex/container_name: overleaf-sharelatex/g' | \
  sed '/host_ip: 127\.0\.0\.1/d')"

# 5. Print resolved compose config
echo "$COMPOSE_CONFIG"

# 6. Append ZimaOS / CasaOS metadata schema
cat << 'EOF'

x-casaos:
  architectures:
    - amd64
    - arm64
  main: sharelatex
  title:
    en_us: Bao's Overleaf
  icon: https://cdn.simpleicons.org/overleaf/47A141
  tagline:
    en_us: Overleaf Community Edition + Clanker AI
  description:
    en_us: Self-hosted Overleaf with custom LaTeX packages and Clanker AI assistant.
  port_map: "8008"
  index: /
EOF
