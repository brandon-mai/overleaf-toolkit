#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
TOOLKIT_ROOT="$(realpath "$SCRIPT_DIR/..")"

# 1. Dynamically resolve all compose files, overrides, and environment variables
COMPOSE_CONFIG="$("${TOOLKIT_ROOT}/bin/docker-compose" config)"

# 2. Print resolved compose config
echo "$COMPOSE_CONFIG"

# 3. Append ZimaOS / CasaOS metadata schema
cat << 'EOF'

x-casaos:
  architectures:
    - amd64
    - arm64
  main: sharelatex
  title:
    en_us: Bao's Overleaf
  icon: https://cdn.simpleicons.org/overleaf/47A141
  tagline:
    en_us: Overleaf Community Edition + Clanker AI
  description:
    en_us: Self-hosted Overleaf with custom LaTeX packages and Clanker AI assistant.
  port_map: "8008"
  index: /
EOF
